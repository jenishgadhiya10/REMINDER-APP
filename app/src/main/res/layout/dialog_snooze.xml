<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="😴 Snooze Options"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <Button
        android:id="@+id/btn_snooze_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Snooze for 5 minutes"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_snooze_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Snooze for 15 minutes"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btn_snooze_60"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Snooze for 1 hour"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginTop="10dp" />

</LinearLayout>
